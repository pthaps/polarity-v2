
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — default is gemini-2.5-flash; override if needed (see ai.google.dev models):
# GEMINI_MODEL=gemini-2.5-flash-lite

# Optional — analysis history + /api/feedback (needs `feedback` table — see supabase-migration.sql)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Reserved for future use
# FACTCHECK_API_KEY=

# Required for production API admission. Server-only values.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional search results and cost estimates. Use the rates for the configured provider plans.
# TAVILY_API_KEY=
# GEMINI_INPUT_USD_PER_MILLION=
# GEMINI_OUTPUT_USD_PER_MILLION=
# TAVILY_USD_PER_CREDIT=
